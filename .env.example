# Copiez ce fichier en .env.local (en local) ou saisissez ces variables dans Vercel > Settings > Environment Variables.
# Sans Supabase, le site tourne en MODE DÉMO (données fictives, mot de passe admin : demo).

# --- Admin ---
ADMIN_PASSWORD=choisissez-un-long-mot-de-passe
# Chaîne aléatoire d'au moins 32 caractères (signature des sessions)
ADMIN_SECRET=
# Facultatif : un domaine réservé à l'admin, ex. admin.mondomaine.fr
ADMIN_HOST=

# --- Supabase (Project Settings > API) ---
SUPABASE_URL=
# Clé "service_role" : SECRÈTE, ne jamais la mettre dans du code côté navigateur
SUPABASE_SERVICE_ROLE_KEY=
# Facultatif : connexion directe à Postgres, pour "npm run db:migrate" (mises à jour du schéma).
# Supabase > Connect > "Session pooler" : postgresql://postgres.xxxx:[MOT-DE-PASSE]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# --- Stripe (Développeurs > Clés API) ---
# Commencez avec sk_test_..., passez à sk_live_... quand tout est validé
STRIPE_SECRET_KEY=
# Développeurs > Webhooks > votre endpoint > "Signing secret" (whsec_...)
STRIPE_WEBHOOK_SECRET=

# --- E-mails (facultatif, https://resend.com) ---
RESEND_API_KEY=
# Partie avant le @ de l'adresse d'envoi (commandes@votre-domaine)
EMAIL_FROM_LOCAL=commandes

# --- Agents (veille, construction de boutique, contenu) ---
# Clé API Anthropic : https://console.anthropic.com > API Keys. Sans elle, les agents tournent en mode démo.
ANTHROPIC_API_KEY=
# Modèle utilisé par les agents
ANTHROPIC_MODEL=claude-sonnet-5-5
# Chaîne aléatoire : protège les tâches planifiées (Vercel l'envoie automatiquement)
CRON_SECRET=
# false = les guides hebdomadaires restent en brouillon jusqu'à votre validation
AGENT_AUTOPUBLISH=true
# Clé IndexNow (32 caractères hexadécimaux) : prévient Bing à chaque publication
INDEXNOW_KEY=
# Fuseau horaire des statistiques
ADMIN_TIMEZONE=Europe/Paris

# --- Commandes fournisseur automatiques (CJ Dropshipping, gratuit) ---
# CJ > My CJ > Authorization > API : générez une clé API
CJ_API_KEY=
# balance = payée tout de suite avec votre solde CJ ; manual = créée chez CJ, vous payez à la main
CJ_PAY_MODE=balance
# Au-delà de ce coût fournisseur (en centimes), la commande attend votre approbation
AUTO_FULFILL_MAX_CENTS=15000
# false = jamais d'envoi automatique
AUTO_FULFILL=true

# --- Rapport du matin (facultatif, gratuit) ---
REPORT_EMAIL=vous@exemple.fr
# Expéditeur sur un domaine vérifié dans Resend
REPORT_FROM=Rapports <rapport@votre-domaine.fr>
# Telegram : créez un bot avec @BotFather, puis récupérez votre chat id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Sel de la mesure d'audience sans cookie (chaîne aléatoire)
ANALYTICS_SALT=

# --- Divers ---
# Boutique affichée pour un domaine inconnu (ex. l'adresse .vercel.app de test)
DEFAULT_SITE=

# --- Mise en ligne et domaines automatiques (facultatif, gratuit) ---
# Vercel > Account Settings > Tokens : jeton qui permet d'ajouter les domaines depuis l'admin (onglet Domaine)
# et à "npm run setup" de créer le projet, d'envoyer les variables et de déployer.
VERCEL_TOKEN=
# Vercel > projet > Settings > General > Project ID (prj_...). Rempli par "npm run setup" s'il crée le projet.
VERCEL_PROJECT_ID=
# Seulement si le projet appartient à une équipe Vercel : Team ID (team_...)
VERCEL_TEAM_ID=
# Utilisé seulement par "npm run setup" sur votre ordinateur (jamais envoyé à Vercel) :
# GitHub > Settings > Developer settings > Fine-grained tokens, dépôt multiboutique, permission "Secrets" en écriture.
GITHUB_TOKEN=
# Dépôt GitHub du projet (propriétaire/nom)
GITHUB_REPO=maximdprt/multiboutique
